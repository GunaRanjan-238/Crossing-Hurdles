+    )
+
+    await t.step(
+      "Should update documents of KvObject type using deep merge",
+      async () => {
+        await useDb(async (db) => {
+          const cr = await db.i_users.addMany(mockUsersWithAlteredAge)
+          assert(cr.ok)
+
+          const docs = await db.i_users.getMany()
